<?xml version="1.0" encoding="utf-8"?>
<!-- Atalhos do ícone do app (tocar e segurar) e base para o Google Assistente. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="talk_to_cesar"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_talk_short"
        android:shortcutLongLabel="@string/shortcut_talk_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.krezio.ai"
            android:targetClass="com.krezio.ai.MainActivity"
            android:data="krezio://app/chat?voz=1" />
    </shortcut>
    <shortcut
        android:shortcutId="new_expense"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_add_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.krezio.ai"
            android:targetClass="com.krezio.ai.MainActivity"
            android:data="krezio://app/chat" />
    </shortcut>
</shortcuts>
