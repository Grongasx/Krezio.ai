{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinancialIntentSchema",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["expense", "income", "transfer", "query", "unknown"]
    },
    "amount": {
      "type": ["number", "null"],
      "description": "Monetary value in BRL (ex: 50.00)"
    },
    "category": {
      "type": "string",
      "enum": [
        "supermarket",
        "transport",
        "health",
        "leisure",
        "housing",
        "education",
        "salary",
        "investment",
        "income_other",
        "expense_other",
        "unknown"
      ]
    },
    "payment_method": {
      "type": "string",
      "enum": ["pix", "credit_card", "debit_card", "cash", "bank_slip", "unknown"]
    },
    "date_offset_days": {
      "type": "integer",
      "description": "Relative date offset in days (0 for today, -1 for yesterday, etc.)"
    },
    "description": {
      "type": "string",
      "description": "Clean summary description of the financial item"
    },
    "is_complete": {
      "type": "boolean",
      "description": "Flag indicating if all critical slots are filled for recording the transaction"
    },
    "missing_slots": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of critical slots missing (e.g., ['category', 'payment_method'])"
    },
    "clarification_prompt": {
      "type": ["string", "null"],
      "description": "Empathetic brand-aligned prompt generated to request missing details"
    }
  },
  "required": ["intent", "category", "payment_method", "date_offset_days", "description", "is_complete", "missing_slots"]
}
