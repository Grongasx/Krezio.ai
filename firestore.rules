rules_version = '2';
// Krezio.ai: cada usuário só lê e grava o próprio documento users/{uid}
// (e o que estiver abaixo dele). Todo o resto é negado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function nextEpoch() {
        return request.resource.data.get('resetEpoch', 0);
      }
      function currentEpoch() {
        return resource.data.get('resetEpoch', 0);
      }
      allow read, delete: if isOwner();
      allow create: if isOwner() && nextEpoch() is int && nextEpoch() in [0, 1];
      allow update: if isOwner() && nextEpoch() is int
        && nextEpoch() in [currentEpoch(), currentEpoch() + 1];
      match /{collection}/{document}/{descendant=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
